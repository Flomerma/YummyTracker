# Kopiere diese Datei nach .env.local und trage die Werte aus dem Supabase-Projekt ein.
# Projekt-Einstellungen -> API. .env.local wird nie eingecheckt.

# Oeffentlich, landet im Browser-Bundle:
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"

# Nur serverseitig. Umgeht Row Level Security - darf den Browser nie erreichen
# und niemals mit NEXT_PUBLIC_ praefixiert werden (Konzept 7.4).
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Fuer die Supabase-CLI (npm run db:push / db:diff gegen das Cloudprojekt).
# Nicht nach .env.local, sondern als Shell-Variable oder in supabase/.env setzen.
SUPABASE_PROJECT_REF="<project-ref>"
SUPABASE_DB_PASSWORD="<datenbank-passwort>"
SUPABASE_ACCESS_TOKEN="<token-von-supabase.com/dashboard/account/tokens>"

# Ab Stufe 1, ausschliesslich serverseitig (Konzept 7.5):
ANTHROPIC_API_KEY=""
